#!/bin/sh
# Fake terraform used only to exercise `tfw` end-to-end without cloud creds.
# Set SHIM_PLAN=<file.json> to control what the plan contains.
set -eu
src="${SHIM_PLAN:-$(dirname "$0")/../mixed.json}"

case "${1:-}" in
  plan)
    out=""
    prev=""
    for a in "$@"; do
      case "$prev" in -out) out="$a" ;; esac
      case "$a" in -out=*) out="${a#-out=}" ;; esac
      prev="$a"
    done
    echo "Terraform will perform the following actions:"
    echo
    echo "Plan: 2 to add, 1 to change, 1 to destroy."
    if [ -n "$out" ]; then
      cp "$src" "$out"
      echo "Saved the plan to: $out" >&2
    else
      echo "shim: no -out flag received" >&2
      exit 1
    fi
    ;;
  show)
    # terraform show -json <file>
    cat "${3:-${2:-}}"
    ;;
  apply)
    shift
    echo "SHIM-TERRAFORM-APPLY ~ $*"
    ;;
  *)
    echo "shim: unsupported subcommand: $*" >&2
    exit 1
    ;;
esac
